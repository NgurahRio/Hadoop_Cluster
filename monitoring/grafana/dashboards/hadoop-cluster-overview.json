          "editorMode": "code",
          "expr": "100 * (1 - (avg by (node) (node_filesystem_avail_bytes{job=\"hadoop-nodes\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\", node=~\"$node\"}) / avg by (node) (node_filesystem_size_bytes{job=\"hadoop-nodes\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\", node=~\"$node\"})))",
          "legendFormat": "{{node}}",
          "range": true,
